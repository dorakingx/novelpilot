# NovelPilot — LLM providers (leave keys empty for Demo / Judge Demo mode)
# Provider selection is available in the app UI (Prompt Launcher → AI model).
# These keys make each provider available on the server.

# Google AI Studio / Gemini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
# GOOGLE_AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# OpenRouter / Gemma
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=NovelPilot

# Optional server defaults (used when UI choice is Auto)
# AI_PROVIDER=google
# AI_FALLBACK_PROVIDER=openrouter

# Token cap for all providers (optional)
# AI_MAX_TOKENS_CAP=3500

# Tighter OpenRouter limits when credits are low (OpenRouter only)
# OPENROUTER_LOW_CREDIT_MODE=true

# Legacy single-key config (still supported)
# GEMMA_API_KEY=
# GEMMA_PROVIDER=openrouter
# GEMMA_MODEL=google/gemma-4-31b-it
# GEMMA_API_URL=https://openrouter.ai/api/v1/chat/completions
# GEMMA_MAX_TOKENS_CAP=6000

NEXT_PUBLIC_APP_NAME=NovelPilot
