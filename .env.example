# NovelPilot — OpenRouter live Gemma 4 configuration
# Leave GEMMA_API_KEY empty to use Mock Mode / Judge Demo.
GEMMA_PROVIDER=openrouter
GEMMA_API_KEY=
GEMMA_API_URL=https://openrouter.ai/api/v1/chat/completions
# Gemma 4 Challenge: use a Gemma 4 model. If unavailable on OpenRouter, pick one from https://openrouter.ai/models
GEMMA_MODEL=google/gemma-4-31b-it

# Optional OpenRouter metadata
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=NovelPilot

# Optional cap for low-credit OpenRouter accounts
# GEMMA_MAX_TOKENS_CAP=6000

# Optional client-safe display name
NEXT_PUBLIC_APP_NAME=NovelPilot

# Google generateContent alternative:
# GEMMA_PROVIDER=google
# GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# GEMMA_MODEL=your_google_gemma_4_model_name_here
